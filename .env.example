# ──────────────────────────────────────────────
# LLVM IR Fuzzing Pipeline – Example Environment Config
# Copy to .env and fill in secrets locally (do NOT commit .env)
# ──────────────────────────────────────────────

# LLM provider used by mutator_type="llm": ollama | groq
LLM_PROVIDER=ollama

# Ollama settings (when LLM_PROVIDER=ollama)
OLLAMA_HOST=http://host.docker.internal:11434
LLM_MODEL=qwen2.5:1.5b

# Groq settings (when LLM_PROVIDER=groq)
# GROQ_API_KEY=your-groq-api-key
# GROK_API_KEY=legacy-alias-supported-but-deprecated
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b
GROQ_MAX_TOKENS=1500
# For Qwen reasoning models, set to hidden to avoid thinking tokens in output:
# GROQ_REASONING_FORMAT=hidden

# Groq retry/backoff (handles 429 Too Many Requests)
GROQ_MAX_RETRIES=6
GROQ_RETRY_BASE_SLEEP_S=1.0
GROQ_RETRY_MAX_SLEEP_S=30.0

# Paths
SEED_DIR=./seeds
MUTANT_DIR=./mutants_llm
GRAMMAR_DIR=./mutants_grammar
VALID_DIR=./valid_mutants
INVALID_DIR=./invalid_mutants
LOGS_DIR=./logs
RANDOM_DIR=./mutants_random

# Features
ENABLE_DEDUPLICATION=true
ENABLE_RULE_VALIDATION=true
ENABLE_REFINEMENT=false

# Limits
MAX_REFINEMENT_ATTEMPTS=3
VALIDATION_TIMEOUT=30
